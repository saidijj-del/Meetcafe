rules_version = '2';
service cloud.firestore {
    match /databases/{db}/documents {
        match /meetings/{meetingId} {
            // Anonymous app: anyone with the link can read, create, and update.
            // No delete to prevent tampering with shared links.
            allow read: if true;
            allow create: if true;
            allow update: if true;
            allow delete: if false;
        }
    }
}

